# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit .env.local, .env.production, etc.
.env.local
.env.production
.env.*.local
# .env.example is the TEMPLATE and should always be committed
# All other .env files are gitignored above

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
